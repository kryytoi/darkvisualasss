{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python",
      "config": {
        "excludeFiles": "{static/darkvisuals.enc,static/*.jar,api/img/**,changes/**,.git/**}"
      }
    },
    {
      "src": "static/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/img/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/darkvisuals.enc",
      "headers": { "Cache-Control": "public, max-age=3600" },
      "dest": "/static/darkvisuals.enc"
    },
    {
      "src": "/static/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/api/img/([0-9a-f]{32}\\.(?:png|jpg|jpeg|gif|webp))",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    { "handle": "filesystem" },
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ],
  "regions": ["fra1"]
}
